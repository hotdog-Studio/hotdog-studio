---
import { getCollection } from 'astro:content';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import OtherProjects from '../../components/OtherProjects.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisibleCaseStudies } from '../../lib/case-studies';
import { caseStudyHref, sortForIndex } from '../../lib/work';

const studies = sortForIndex(await getVisibleCaseStudies());
// getCollection promises no order. The loader's positional ids ('000', '001', ...) follow the file.
const projects = (await getCollection('otherProjects'))
  .toSorted((a, b) => a.id.localeCompare(b.id))
  .map(({ data }) => data);
---

<BaseLayout title="Work" description="Case studies in test automation and quality engineering.">
  <div class="sections">
    <div class="stack">
      <h1>Work</h1>
      {studies.length > 0 && (
        <div class="card-grid">
          {studies.map(({ id, data }) => (
            <CaseStudyCard
              href={caseStudyHref(id)}
              title={data.title}
              summary={data.summary}
              stack={data.stack}
              source={data.source}
              headingLevel={2}
            />
          ))}
        </div>
      )}
    </div>
    <OtherProjects projects={projects} />
  </div>
</BaseLayout>
