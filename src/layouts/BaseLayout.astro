---
import '../styles/tokens.css';
import '../styles/global.css';
import site from '@site-config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { formatBuildStamp } from '../lib/build-stamp';
import { resolveSiteMode } from '../lib/site-mode';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const buildStamp = formatBuildStamp(process.env, resolveSiteMode(process.env.SITE_MODE));
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader name={site.name} pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1" class="frame">
      <slot />
    </main>
    <SiteFooter links={site.links} email={site.email} buildStamp={buildStamp} />
  </body>
</html>
