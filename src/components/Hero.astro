---
import type { SiteConfig } from '../lib/site-config-schema';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<section aria-labelledby="hero-heading">
  <h1 id="hero-heading">{site.name}</h1>
  <p class="tagline">{site.tagline}</p>
  <p class="pitch">{site.pitch}</p>
  <div class="actions">
    <a class="button primary" href="/work">
      See my work
    </a>
    {site.openToWork.enabled && (
      <a class="button" href={site.cv} download>
        Download CV
      </a>
    )}
    <a class="button" href={`mailto:${site.email}`}>
      Email me
    </a>
  </div>
</section>

<style>
  h1 {
    margin-block-end: 0.25em;
  }

  .tagline {
    margin-block-end: 0.75em;
    font-size: var(--step-2);
    line-height: 1.3;
    text-wrap: balance;
  }

  .pitch {
    max-inline-size: var(--measure);
    margin-block-end: 0;
    color: var(--color-text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }

  /* At least 44px tall, a comfortable target on a phone. */
  .button {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding: 0.375rem 1.25rem;
    border: 1px solid var(--color-text-muted);
    border-radius: 0.375rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration-line: none;
    transition: background-color 150ms ease-out;
  }

  .button:hover {
    background: var(--color-surface);
    text-decoration-line: underline;
  }

  /* The one filled button. Its text is the page background: 5.3:1 in light, 11:1 in dark. */
  .primary,
  .primary:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
  }
</style>
