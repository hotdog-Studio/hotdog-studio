---
import type { OtherProject } from '../lib/content-schemas';

interface Props {
  projects: readonly OtherProject[];
}

const { projects } = Astro.props;

// role="list" keeps the list a list in Safari, which drops the role from a list with no bullets.
---

{projects.length > 0 && (
  <section aria-labelledby="other-projects-heading">
    <h2 id="other-projects-heading">Other things I build</h2>
    <ul class="projects card-grid bare-list" role="list">
      {projects.map(({ name, description, repo }) => (
        <li>
          <a href={repo}>{name}</a>
          <p>{description}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /*
   * Columns as wide as the case-study cards above them, so the two line up. The .card-grid tracks
   * are auto-fill, so a short strip keeps that width instead of stretching across the frame.
   */
  .projects {
    row-gap: 1.5rem;
  }

  /* A hairline rather than a box, so the strip stays quieter than the case-study cards. */
  li {
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-border);
  }

  /*
   * The --step-1 line box (x 1.6) is already over 30px at 320px, so it clears the 24px target
   * (WCAG 2.5.8) with no padding. An inline-block is as wide as its longest word, so `anywhere`
   * lets a long repo name break rather than spill out of its column.
   */
  a {
    display: inline-block;
    font-size: var(--step-1);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
